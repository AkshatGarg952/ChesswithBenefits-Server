# Server Configuration
PORT_NO=3000

# Comma-separated list of origins allowed to call the API / connect over Socket.IO
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when deployed behind a proxy/load balancer (Render, Railway,
# nginx). Required there for rate limiting to see real client IPs.
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb://localhost:27017/chess

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI/Commentary
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stockfish move-analysis tuning (optional — sane defaults if unset)
STOCKFISH_DEPTH=12
STOCKFISH_TIMEOUT_MS=8000
